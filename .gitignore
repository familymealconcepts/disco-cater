# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright — keep the test files in tests/e2e/, ignore generated output
test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
scripts/data/
scripts/output/restaurant-summary.json
.claude/

# Local-only one-off migration runner (not committed)
scripts/run-migration.ts

# stray working CSVs (never commit)
/*.csv
tests/e2e/a11y-out/

# Operational CSV pulls live in data/ and are NOT repo content. Two of them
# (no-admin-contact, unverified-stripe-accounts) were committed twice by a
# `git add -A`, because the rule above (/*.csv) only covers the repo ROOT.
# data/converted-today.csv was already tracked before this line and stays so —
# .gitignore does not untrack what git already knows about.
data/no-admin-contact.csv
data/unverified-stripe-accounts.csv
