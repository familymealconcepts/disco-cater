# Disco Cater — environment variables
# Copy to `.env.local` and fill in. Production values live in Vercel.
# Never commit real secrets — this file documents variable names only.

# ── Maps ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# ── Sanity CMS ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=0j4eqnmw
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_TOKEN=

# ── Anthropic (Disco AI) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Stripe ─────────────────────────────────────────────────────────────────
# Platform secret key (charges, refunds, Connect).
STRIPE_SECRET_KEY=
# Signing secret for the Stripe webhook handler at /api/stripe/webhook.
# Obtain from Revyrie / the Stripe Dashboard. NOTE: that handler is built but
# NOT yet registered in Stripe — until cutover the live webhooks still point at
# FM, so this var is only needed once we activate the new endpoint.
STRIPE_WEBHOOK_SECRET=

# ── Recurring orders (Neon Postgres) ───────────────────────────────────────
DATABASE_URL=

# ── Cron jobs ──────────────────────────────────────────────────────────────
# Shared secret. Vercel Cron sends it as `Authorization: Bearer ${CRON_SECRET}`.
# Gates /api/cron/regenerate-compact, /api/cron/recurring-orders, and
# /api/cron/sync-restaurants.
CRON_SECRET=

# ── FM admin login (FM→Sanity restaurant sync cron) ─────────────────────────
# Server-to-server FM /login for /api/cron/sync-restaurants. Needs an FM admin/
# SUPER_ADMIN account. Without these the sync returns 500.
FM_ADMIN_EMAIL=
FM_ADMIN_PASSWORD=

# ── Mailgun (recurring-orders cron emails: reminders, payment, cancellations) ─
# Already set in Vercel from the become-a-partner menu-upload work.
# If unset, the cron still runs and updates DB statuses but skips email sending.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# ── Slack (new-order notifications from the Stripe webhook) ─────────────────
# Incoming-webhook URL for the #new-orders channel. If unset, the webhook skips
# the Slack ping silently. Messages are labeled 1P (direct) / 3P (marketplace).
SLACK_NEW_ORDER_WEBHOOK_URL=

# ── Export API (CRM sync — /api/export/*) ──────────────────────────────────
# Shared API key for the read-only export endpoints. Sent as the x-api-key
# header or ?api_key= query param. Set the real value in Vercel env vars.
# Generate with: openssl rand -hex 32
DISCO_API_KEY=

# ── GitHub (compact regen commit-back) ─────────────────────────────────────
GITHUB_TOKEN=

# ── Sanity webhook (restaurant change → regenerate compact) ────────────────
# Shared secret configured on the Sanity webhook (Manage → API → Webhooks),
# sent as Authorization: Bearer <secret>, x-sanity-webhook-secret, or ?secret=.
# If unset, /api/webhooks/sanity-restaurant skips (no regen) instead of erroring.
SANITY_WEBHOOK_SECRET=

# ═══════════════════════════════════════════════════════════════════════════
# Added 2026-08-27. Everything above documented 19 of the 46 vars the code
# actually reads — the other 27 were discoverable only by grepping
# process.env, which is how MAILGUN_DOMAIN and FM_MASTER_PASSWORD each went
# missing from a .env.local until a run no-op'd or failed on them. The rest
# of them are below. Regenerate this list with:
#   grep -rhoE 'process\.env\.[A-Za-z_][A-Za-z0-9_]*' app lib scripts \
#     | sed 's/process\.env\.//' | sort -u
# ═══════════════════════════════════════════════════════════════════════════

# ── FM API ─────────────────────────────────────────────────────────────────
# Optional. All ~184 read sites default to 'https://api.familymeal.com', so
# leaving it unset IS the production value. Set only to point at a non-prod FM.
FM_API_BASE_URL=

# ── FM master-admin read (conversion path) ─────────────────────────────────
# FM's universal master password, used to read the walled per-restaurant
# fields (tax rate, notification recipients, closed days) that no service
# account can reach. Read ONLY by lib/fm-master-admin-read.ts, which audits
# every use to disco_admin_audit as FM_MASTER_PASSWORD_READ. Without it
# convertToNative throws 'FM_MASTER_PASSWORD is not configured'.
FM_MASTER_PASSWORD=

# ── Restaurant-portal master password ──────────────────────────────────────
# SHA-256 hash (hex) of the universal restaurant-portal override password.
# Never the password itself. Unset = the override is simply unavailable.
# Every successful use is audited as MASTER_PASSWORD_LOGIN.
MASTER_PASSWORD_HASH=

# ── Mailgun ────────────────────────────────────────────────────────────────
# Sending domain (production: mg.discocater.com). Without it EVERY sendEmail
# call logs 'Mailgun not configured' and returns { success: false } WITHOUT
# sending — a silent no-op, not an error. This is the var to check first when
# email "ran fine" but nothing arrived.
MAILGUN_DOMAIN=
# Key for the warm announcement domain (mg.familymeal.com). Consulted ONLY
# when a caller overrides the domain, so transactional mail is unaffected by
# its absence. Unset + an override = a 401 that's hard to trace.
MAILGUN_CAMPAIGN_API_KEY=

# ── Stripe (additional) ────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_TEST_SECRET_KEY=
# OAuth client id for Connect onboarding links.
STRIPE_CONNECT_CLIENT_ID=
# Signing secret for the account.updated webhook (Stripe-readiness sync).
STRIPE_ACCOUNT_WEBHOOK_SECRET=

# ── Slack (beyond #new-orders above) ───────────────────────────────────────
# #notifications — the ONLY channel lib/ops-alert.ts posts to, with no
# fallback by design. Unset (its state in Vercel production as of 2026-08-27)
# means every alertOps() call is console-only: silent mirror failures, stalled
# cursors and conversion-path warnings never reach Slack.
SLACK_NOTIFICATIONS_WEBHOOK_URL=
# become-a-partner signups.
SLACK_PARTNER_WEBHOOK_URL=
# Stripe-account-connected pings.
SLACK_STRIPE_CONNECTED_WEBHOOK_URL=

# ── Twilio (order SMS) ─────────────────────────────────────────────────────
# All three required together; any missing one disables SMS silently.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Expedite (dlivrd courier dispatch) ─────────────────────────────────────
EXPEDITE_TOKEN=
EXPEDITE_SECRET=
# Gate at app/api/stripe/webhook/route.ts:176. Set + credentials present means
# a native order dispatches a REAL courier.
EXPEDITE_NATIVE_DISPATCH_ENABLED=

# ── Menu upload (become-a-partner) ─────────────────────────────────────────
MENUUPLOAD_BASE_URL=
MENUUPLOAD_API_KEY=

# ── Vercel Blob (image + asset uploads) ────────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ── Marketing unsubscribe links ────────────────────────────────────────────
# lib/marketing-opt-out.ts THROWS 'UNSUBSCRIBE_SECRET is not set' rather than
# degrading — a campaign send fails outright without it.
UNSUBSCRIBE_SECRET=

# ── Native checkout tuning (all optional, code-default if unset) ───────────
NATIVE_RESERVED_EXPIRY_MINUTES=
NATIVE_PAYMENT_RECONCILIATION_LOOKBACK_HOURS=
NATIVE_INVOICE_ENABLED=

# ── Invite pacing (optional, code-default if unset) ────────────────────────
# Delay between bulk invites (default 120000 = 2 min) and between invites to
# the same restaurant during a conversion.
BULK_INVITE_DELAY_MS=
SAME_RESTAURANT_INVITE_DELAY_MS=

# ── Absolute base URL for links in Stripe redirects ───────────────────────
# Defaults to 'https://www.discocater.com'.
NEXT_PUBLIC_BASE_URL=

# ── Aliases and client-side variants (each has a code default) ─────────────
# Non-public aliases read alongside their NEXT_PUBLIC_ twins above.
SANITY_PROJECT_ID=
SANITY_DATASET=
# Third fallback in the become-a-partner geocode key chain
# (GOOGLE_PLACES_API_KEY → NEXT_PUBLIC_GOOGLE_MAPS_API_KEY → this).
GOOGLE_MAPS_API_KEY=
# Client-side FM bases; both default to the production FM host.
NEXT_PUBLIC_FM_API_BASE_URL=
NEXT_PUBLIC_FM_PUBLIC_BASE=
NEXT_PUBLIC_MENUUPLOAD_DOMAIN=

# ── Admin test runner only (/api/admin/tests/run) ──────────────────────────
# Unset = the affected test steps report as skipped, nothing else breaks.
TEST_CUSTOMER_EMAIL=
TEST_CUSTOMER_PASSWORD=
TEST_STRIPE_PAYMENT_METHOD=
STRIPE_TEST_CONNECTED_ACCOUNT=
