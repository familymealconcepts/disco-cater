# Disco Cater — environment variables
# Copy to `.env.local` and fill in. Production values live in Vercel.
# Never commit real secrets — this file documents variable names only.

# ── Maps ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# ── Sanity CMS ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=0j4eqnmw
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_TOKEN=

# ── Anthropic (Disco AI) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Recurring orders (Neon Postgres) ───────────────────────────────────────
DATABASE_URL=

# ── Cron jobs ──────────────────────────────────────────────────────────────
# Shared secret. Vercel Cron sends it as `Authorization: Bearer ${CRON_SECRET}`.
# Gates /api/cron/regenerate-compact, /api/cron/recurring-orders, and
# /api/cron/sync-restaurants.
CRON_SECRET=

# ── FM admin login (FM→Sanity restaurant sync cron) ─────────────────────────
# Server-to-server FM /login for /api/cron/sync-restaurants. Needs an FM admin/
# SUPER_ADMIN account. Without these the sync returns 500.
FM_ADMIN_EMAIL=
FM_ADMIN_PASSWORD=

# ── Mailgun (recurring-orders cron emails: reminders, payment, cancellations) ─
# Already set in Vercel from the become-a-partner menu-upload work.
# If unset, the cron still runs and updates DB statuses but skips email sending.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# ── GitHub (compact regen commit-back) ─────────────────────────────────────
GITHUB_TOKEN=

# ── Sanity webhook (restaurant change → regenerate compact) ────────────────
# Shared secret configured on the Sanity webhook (Manage → API → Webhooks),
# sent as Authorization: Bearer <secret>, x-sanity-webhook-secret, or ?secret=.
# If unset, /api/webhooks/sanity-restaurant skips (no regen) instead of erroring.
SANITY_WEBHOOK_SECRET=
