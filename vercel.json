{
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "restaurant.discocater.com"
        }
      ],
      "destination": "/restaurant/$1"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "admin.discocater.com"
        }
      ],
      "destination": "/admin/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/regenerate-compact",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/recurring-orders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/refresh-map-cache",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/sync-restaurants",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/sync-fm-orders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/sync-fm-orders-noncache",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/order-reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/scheduled-reports",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/menu-drift-check",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/sync-fm-customers",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/expire-reserved-native-orders",
      "schedule": "0 * * * *"
    }
  ]
}
